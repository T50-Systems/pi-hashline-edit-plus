{
  "name": "pi-hashline-edit-plus",
  "version": "0.1.1",
  "description": "Cross-platform hashline read/edit override for Pi that avoids fragile oldText exact matches",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T50-Systems/pi-hashline-edit-plus.git"
  },
  "author": "cervantesh",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "hashline",
    "windows",
    "crlf",
    "tool-override"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "diff": "^8.0.2",
    "file-type": "^21.3.0",
    "xxhashjs": "^0.2.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "knip": "knip --production",
    "check": "npm run typecheck && npm run knip && npm test",
    "release:pack": "npm pack",
    "upstream:check": "npm view pi-hashline-edit version repository --json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@types/node": "^22.0.0",
    "@types/xxhashjs": "^0.2.4",
    "ajv": "^8.20.0",
    "knip": "^6.16.1",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "homepage": "https://github.com/T50-Systems/pi-hashline-edit-plus",
  "bugs": {
    "url": "https://github.com/T50-Systems/pi-hashline-edit-plus/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
