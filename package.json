{
  "name": "pi-hashline-edit-plus",
  "version": "0.1.3",
  "description": "Cross-platform hashline read/edit override for Pi that avoids fragile oldText exact matches",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T50-Systems/pi-hashline-edit-plus.git"
  },
  "author": "cervantesh",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "hashline",
    "windows",
    "crlf",
    "tool-override"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "prompts",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "diff": "^8.0.2",
    "pi-anchor-edit-core": "https://github.com/T50-Systems/pi-anchor-edit-core/archive/fa10abb76aee5e745ad291aff4448b09fd1cb47d.tar.gz"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "knip": "knip --production",
    "release:check": "node scripts/verify-release.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "repository:check": "node scripts/verify-repository-settings.mjs",
    "workflow:check": "node scripts/verify-workflows.mjs",
    "node-support:check": "node scripts/verify-node-support.mjs",
    "check": "npm run workflow:check && npm run node-support:check && npm run typecheck && npm run knip && npm run release:check && npm run coverage",
    "benchmark": "vitest bench --run benchmark/hashline.bench.ts",
    "package:check": "npm pack --dry-run",
    "security:signatures": "npm audit signatures",
    "release:pack": "npm pack",
    "upstream:check": "npm view pi-hashline-edit version repository --json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "actionlint": "2.0.6",
    "ajv": "^8.20.0",
    "knip": "^6.27.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/T50-Systems/pi-hashline-edit-plus",
  "bugs": {
    "url": "https://github.com/T50-Systems/pi-hashline-edit-plus/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
